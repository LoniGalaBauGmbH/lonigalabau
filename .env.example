# ─── Supabase – NEUE DATENBANK ────────────────────────────────────────────────
# Ersetze die Werte unten mit den Daten aus deinem neuen Supabase-Projekt.
# Du findest sie unter: Supabase Dashboard → Settings → API
#
#   Project URL    → SUPABASE_URL + VITE_SUPABASE_URL
#   anon/public    → SUPABASE_PUBLISHABLE_KEY + VITE_SUPABASE_PUBLISHABLE_KEY
#   Secret Key     → SUPABASE_SECRET_KEY (NUR auf dem Server – niemals im Browser!)
#   Ein vorhandener Legacy-service_role-Key wird weiterhin über SUPABASE_SERVICE_ROLE_KEY unterstützt.
#   Project ID     → VITE_SUPABASE_PROJECT_ID (der Teil vor .supabase.co)
# ──────────────────────────────────────────────────────────────────────────────

SUPABASE_URL="https://DEINE-PROJEKT-ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_DEIN-ANON-KEY"
SUPABASE_SECRET_KEY="sb_secret_DEIN-SERVER-KEY"

VITE_SUPABASE_URL="https://DEINE-PROJEKT-ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_DEIN-ANON-KEY"
VITE_SUPABASE_PROJECT_ID="DEINE-PROJEKT-ID"

# Resend: nur Server, keine VITE_-Variablen
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
NOTIFICATION_TO_EMAIL="webseite@loni-galabau.de"
SITE_URL="https://loni-galabau.serhad1999.chatgpt.site"
VITE_SITE_URL="https://loni-galabau.serhad1999.chatgpt.site"
